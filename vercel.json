{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{server.ts,src/lib/**}"
    }
  },
  "crons": [{ "path": "/api/editorial-worker", "schedule": "*/1 * * * *" }],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
